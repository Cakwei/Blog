{
  "name": "blog",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "start": "node .output/server/index.mjs",
    "start:dev": "node --env-file:.env .output/server/index.mjs",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "dotenv -e .env -- prisma generate && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "db:generate": "dotenv -e .env -- prisma generate",
    "db:push": "dotenv -e .env -- prisma db push",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:migrate-reset": "dotenv -e .env -- prisma migrate reset",
    "db:studio": "dotenv -e .env -- prisma studio",
    "db:seed": "dotenv -e .env -- prisma db seed",
    "db:reset": "dotenv -e .env -- prisma db push --force-reset"
  },
  "dependencies": {
